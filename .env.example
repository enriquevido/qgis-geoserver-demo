# ──────────────────────────────
# PostGIS
# ──────────────────────────────
POSTGRES_DB=gis
POSTGRES_USER=docker
POSTGRES_PASSWORD=docker

# ──────────────────────────────
# GeoServer
# ──────────────────────────────
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=geoserver

# ──────────────────────────────
# Backend FastAPI
# ──────────────────────────────
DATABASE_URL=postgresql+asyncpg://docker:docker@localhost:5432/gis
CORS_ORIGINS=http://localhost:5173

# ──────────────────────────────
# Frontend (VITE_* se exponen al navegador)
# ──────────────────────────────
VITE_API_BASE=http://localhost:8000/api
VITE_WMS_URL=http://localhost:8080/geoserver/demo/wms
